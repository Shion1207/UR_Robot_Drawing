<?xml version="1.0" ?>
<!--
  Moi truong pick & place cho UR3/UR3e:
    - 01 ban thao tac (mat ban o z = 0, robot dat tren mat ban tai goc toa do)
    - 05 khoi lap phuong 4 cm: red/yellow/blue/green/purple_cube
    - 03 vung dat vat (chi co visual, khong co collision): zone_a, zone_b, zone_c
    - 01 camera RGB co dinh nhin vuong goc tu tren xuong
  Vi tri phai trung voi config/scene.yaml.

  Cac khoi lap phuong la vat the dong (co khoi luong + collision): Robotiq 2F-85 kep bang
  ngon that, khi kep xong plugin DetachableJoint (khai bao trong urdf/ur_robotiq.urdf.xacro)
  khoa khoi vao gripper de khong bi truot. Ten model phai trung voi grasp_objects cua xacro.
-->
<sdf version="1.6">
  <world name="pick_place_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.3 -0.9 0.9 0 0.45 2.55</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Camera RGB bat buoc: optical axis nhin thang xuong mat ban. -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>0.15 0 1.20 0 1.57079632679 0</pose>
      <link name="camera_link">
        <sensor name="rgb_camera" type="camera">
          <topic>/overhead_camera/image</topic>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image><width>800</width><height>800</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ban thao tac: 0.90 x 1.00 x 0.75 m, mat tren o z = 0 -->
    <model name="table">
      <static>true</static>
      <pose>0.15 0 -0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.90 1.00 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.90 1.00 0.75</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vung dat vat: tam phang mong, chi hien thi -->
    <model name="zone_a">
      <static>true</static>
      <pose>0.282 0.103 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.25 0.25 0.25 1</ambient>
            <diffuse>0.25 0.25 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_b">
      <static>true</static>
      <pose>0.212 0.212 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_c">
      <static>true</static>
      <pose>0.103 0.282 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vat the: khoi lap phuong 4 cm -->
    <model name="red_cube">
      <pose>0.150 -0.260 0.020 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="yellow_cube">
      <pose>0.246 -0.172 0.020 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.212 0.212 0.020 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.95 1</ambient>
            <diffuse>0.1 0.3 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="green_cube">
      <pose>0.390 -0.170 0.020 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.1 0.85 0.2 1</ambient><diffuse>0.1 0.85 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <model name="purple_cube">
      <pose>0.400 -0.300 0.020 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.65 0.15 0.85 1</ambient><diffuse>0.65 0.15 0.85 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
