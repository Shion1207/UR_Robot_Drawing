<?xml version="1.0" ?>
<!--
  Moi truong pick & place cho UR3/UR3e:
    - 01 ban thao tac (mat ban o z = 0, robot dat tren mat ban tai goc toa do)
    - 03 khoi lap phuong 4 cm: red_cube, yellow_cube, blue_cube
    - 03 vung dat vat (chi co visual, khong co collision): zone_a, zone_b, zone_c
      va vung tam zone_tmp (xam)
  Vi tri phai trung voi config/scene.yaml.

  Cac khoi lap phuong la vat the dong (co khoi luong + collision): Robotiq 2F-85 kep bang
  ngon that, khi kep xong plugin DetachableJoint (khai bao trong urdf/ur_robotiq.urdf.xacro)
  khoa khoi vao gripper de khong bi truot. Ten model phai trung voi grasp_objects cua xacro.
-->
<sdf version="1.6">
  <world name="pick_place_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>1.3 -0.9 0.9 0 0.45 2.55</pose>
      </camera>
    </gui>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Ban thao tac: 0.90 x 1.00 x 0.75 m, mat tren o z = 0 -->
    <model name="table">
      <static>true</static>
      <pose>0.15 0 -0.375 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.90 1.00 0.75</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.90 1.00 0.75</size></box></geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vung dat vat: tam phang mong, chi hien thi -->
    <model name="zone_a">
      <static>true</static>
      <pose>0.282 0.103 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.2 0.8 0.2 1</ambient>
            <diffuse>0.2 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_b">
      <static>true</static>
      <pose>0.212 0.212 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.6 0.3 0.8 1</ambient>
            <diffuse>0.6 0.3 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_c">
      <static>true</static>
      <pose>0.103 0.282 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>1.0 0.55 0.1 1</ambient>
            <diffuse>1.0 0.55 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="zone_tmp">
      <static>true</static>
      <pose>0.020 -0.300 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.002</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vat the: khoi lap phuong 4 cm -->
    <model name="red_cube">
      <pose>0.150 -0.260 0.020 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="yellow_cube">
      <pose>0.246 -0.172 0.020 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.95 0.85 0.1 1</ambient>
            <diffuse>0.95 0.85 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_cube">
      <pose>0.295 -0.052 0.020 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>1.33e-5</ixx><iyy>1.33e-5</iyy><izz>1.33e-5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.95 1</ambient>
            <diffuse>0.1 0.3 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
