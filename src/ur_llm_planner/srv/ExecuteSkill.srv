# Goi mot robot skill. Chi skill_server moi duoc phep dieu khien robot (qua MoveIt 2).
#   skill : home | pick | place | move_above | move_to_zone | open_gripper | close_gripper
#   object: ten vat (vd: red_cube), de trong neu skill khong can
#   zone  : ten vung (vd: zone_b), de trong neu skill khong can
string skill
string object
string zone
---
# SUCCESS | FAILED | INVALID_SKILL | INVALID_OBJECT | INVALID_ZONE | PLANNING_FAILED
# EXECUTION_FAILED | OBJECT_NOT_HELD | GRIPPER_BUSY | NO_OBJECT_TO_GRASP
string status
string message
