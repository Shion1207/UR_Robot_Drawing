<?xml version="1.0"?>
<sdf version="1.8">
  <world name="gesture_arena">
    <physics name="gesture_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="ignition::gazebo::systems::Physics" filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands" filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster" filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Contact" filename="ignition-gazebo-contact-system"/>
    <gravity>0 0 -9.8</gravity>
    <scene><ambient>0.65 0.65 0.65 1</ambient><background>0.75 0.80 0.85 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.2 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="ground">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>14 14</size></plane></geometry>
          <material><ambient>0.70 0.72 0.70 1</ambient><diffuse>0.70 0.72 0.70 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- 10 x 10 m open area; LiDAR-visible boundary, no inner obstacle. -->
    <model name="arena_walls">
      <static>true</static>
      <link name="west"><pose>-5 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 10.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 10.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
      <link name="east"><pose>5 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 10.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 10.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
      <link name="north"><pose>0 5 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.15 0.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.15 0.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
      <link name="south"><pose>0 -5 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>10.15 0.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>10.15 0.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
