<?xml version="1.0"?>
<sdf version="1.8">
  <world name="small_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="ignition::gazebo::systems::Physics"
            filename="ignition-gazebo-physics-system"/>
    <plugin name="ignition::gazebo::systems::UserCommands"
            filename="ignition-gazebo-user-commands-system"/>
    <plugin name="ignition::gazebo::systems::SceneBroadcaster"
            filename="ignition-gazebo-scene-broadcaster-system"/>
    <plugin name="ignition::gazebo::systems::Contact"
            filename="ignition-gazebo-contact-system"/>

    <gravity>0 0 -9.8</gravity>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.75 0.80 0.85 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>12 10</size></plane></geometry>
          <material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Compact 8 x 6 m boundary. -->
    <model name="room_walls">
      <static>true</static>
      <link name="west">
        <pose>-4 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 6.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
      <link name="east">
        <pose>4 0 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 6.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 6.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
      <link name="north">
        <pose>0 3 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.15 0.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.15 0.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
      <link name="south">
        <pose>0 -3 0.6 0 0 0</pose>
        <collision name="collision"><geometry><box><size>8.15 0.15 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8.15 0.15 1.2</size></box></geometry><material><ambient>0.25 0.35 0.55 1</ambient><diffuse>0.25 0.35 0.55 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Asymmetric obstacles give SLAM clear features and leave wide passages. -->
    <model name="inner_obstacles">
      <static>true</static>
      <link name="vertical_wall">
        <pose>1.55 0.75 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.25 2.4 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.25 2.4 1.0</size></box></geometry><material><ambient>0.65 0.28 0.18 1</ambient><diffuse>0.65 0.28 0.18 1</diffuse></material></visual>
      </link>
      <link name="horizontal_wall">
        <pose>-1.45 -1.35 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>2.3 0.25 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.3 0.25 1.0</size></box></geometry><material><ambient>0.20 0.55 0.32 1</ambient><diffuse>0.20 0.55 0.32 1</diffuse></material></visual>
      </link>
      <link name="square_column">
        <pose>-2.5 1.55 0.5 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.7 0.7 1.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.7 0.7 1.0</size></box></geometry><material><ambient>0.55 0.45 0.15 1</ambient><diffuse>0.55 0.45 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- A chair-shaped object provides a recognizable class for the YOLO demo. -->
    <model name="yolo_chair">
      <static>true</static>
      <pose>-0.2 2.15 0 0 0 -0.35</pose>
      <link name="chair">
        <collision name="seat_collision">
          <pose>0 0 0.47 0 0 0</pose>
          <geometry><box><size>0.55 0.55 0.10</size></box></geometry>
        </collision>
        <visual name="seat_visual">
          <pose>0 0 0.47 0 0 0</pose>
          <geometry><box><size>0.55 0.55 0.10</size></box></geometry>
          <material><ambient>0.35 0.12 0.05 1</ambient><diffuse>0.55 0.22 0.08 1</diffuse></material>
        </visual>

        <collision name="back_collision">
          <pose>-0.24 0 0.82 0 0 0</pose>
          <geometry><box><size>0.10 0.55 0.65</size></box></geometry>
        </collision>
        <visual name="back_visual">
          <pose>-0.24 0 0.82 0 0 0</pose>
          <geometry><box><size>0.10 0.55 0.65</size></box></geometry>
          <material><ambient>0.35 0.12 0.05 1</ambient><diffuse>0.55 0.22 0.08 1</diffuse></material>
        </visual>

        <collision name="front_left_leg_collision">
          <pose>0.21 0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
        </collision>
        <visual name="front_left_leg_visual">
          <pose>0.21 0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
          <material><ambient>0.22 0.07 0.03 1</ambient><diffuse>0.36 0.12 0.04 1</diffuse></material>
        </visual>

        <collision name="front_right_leg_collision">
          <pose>0.21 -0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
        </collision>
        <visual name="front_right_leg_visual">
          <pose>0.21 -0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
          <material><ambient>0.22 0.07 0.03 1</ambient><diffuse>0.36 0.12 0.04 1</diffuse></material>
        </visual>

        <collision name="rear_left_leg_collision">
          <pose>-0.21 0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
        </collision>
        <visual name="rear_left_leg_visual">
          <pose>-0.21 0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
          <material><ambient>0.22 0.07 0.03 1</ambient><diffuse>0.36 0.12 0.04 1</diffuse></material>
        </visual>

        <collision name="rear_right_leg_collision">
          <pose>-0.21 -0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
        </collision>
        <visual name="rear_right_leg_visual">
          <pose>-0.21 -0.21 0.22 0 0 0</pose>
          <geometry><box><size>0.07 0.07 0.44</size></box></geometry>
          <material><ambient>0.22 0.07 0.03 1</ambient><diffuse>0.36 0.12 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
